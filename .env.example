# Copia este archivo a .env para correr el proyecto en tu computadora.
# En Render, estas mismas variables se configuran en el panel del servicio
# (no subas nunca tu archivo .env real a GitHub).

# Cadena de conexión a PostgreSQL. Render te la da al crear la base de datos
# (usa la "Internal Database URL" si el servicio web y la base están en Render).
DATABASE_URL=postgres://usuario:password@host:5432/nombre_basededatos

# Código simple que tú y tu amigo usarán para entrar a la app.
# Si lo dejas vacío, la API queda sin protección (cualquiera con la URL puede leer/escribir).
ACCESS_CODE=cambia-esto-por-algo-tuyo

# Puerto local (Render lo asigna solo, esto es solo para desarrollo local)
PORT=3000
